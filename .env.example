# =====================================================
# Application
# =====================================================

PROJECT_NAME=rag-chatbot

# =====================================================
# Database (PostgreSQL)
# =====================================================

# Async URL used by the app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_chatbot

# Sync URL used by Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/rag_chatbot

# =====================================================
# JWT Authentication
# =====================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

JWT_ALGORITHM=HS256

JWT_EXPIRATION_MINUTES=30

# =====================================================
# Embeddings
# =====================================================

EMBEDDING_MODEL=all-MiniLM-L6-v2

# =====================================================
# Chunking
# =====================================================

CHUNK_SIZE=1000

CHUNK_OVERLAP=200

# =====================================================
# Vector DB
# =====================================================

CHROMA_PATH=./vector_db

# =====================================================
# LLM
# =====================================================

# ollama | gemini
LLM_PROVIDER=ollama

OLLAMA_MODEL=llama3.1

# Only required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# =====================================================
# Retrieval
# =====================================================

RETRIEVAL_TOP_K=5

# Vector
TOP_K_VECTOR=10

VECTOR_DISTANCE_THRESHOLD=0.75

VECTOR_SIMILARITY_THRESHOLD=0.25

# BM25
TOP_K_BM25=10

BM25_PATH=./storage/bm25

# Hybrid
VECTOR_WEIGHT=0.6

BM25_WEIGHT=0.4

HYBRID_TOP_K=10

HYBRID_SCORE_THRESHOLD=0.30

# Reranking
RERANK_TOP_K=3

RERANKER_SCORE_THRESHOLD=0.20

# Hallucination Guard
ENABLE_HALLUCINATION_GUARD=true

HALLUCINATION_THRESHOLD=0.75
