# Baked into the static export at build time (Next.js inlines
# NEXT_PUBLIC_ vars into the client bundle during `next build`). Not a
# secret - it's the public URL of the deployed backend. Committed
# deliberately so the static build works the same regardless of
# whether the hosting platform exposes its own env vars during the
# build step - see .gitignore for why this file is excluded from the
# .env* blanket-ignore.
NEXT_PUBLIC_API_URL=https://rag-chatbot-sj01.onrender.com
